# Extension build configuration. CI/release packages currently use this
# verified Cloud Run license API origin.
PLASMO_PUBLIC_PHOTOSWEEP_LICENSE_API_BASE_URL=https://photosweep-license-api-206538169327.us-west1.run.app
PLASMO_PUBLIC_PHOTOSWEEP_ENTITLEMENT_PUBLIC_KEY=BASE64URL_SPKI_PUBLIC_KEY
# Dev/test only. Never set this in production extension builds.
PLASMO_PUBLIC_PHOTOSWEEP_ALLOW_DEV_ENTITLEMENT=0

# License API configuration
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
PHOTOSWEEP_ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
PHOTOSWEEP_ENTITLEMENT_PRIVATE_KEY=BASE64URL_PKCS8_PRIVATE_KEY
PHOTOSWEEP_STRIPE_PRICE_MINI_CLEANUP=price_...
PHOTOSWEEP_STRIPE_PRICE_CLEANUP_PASS_7D=price_...
PHOTOSWEEP_STRIPE_PRICE_LIFETIME_EARLY_ACCESS=price_...
PHOTOSWEEP_CHECKOUT_SUCCESS_URL=https://photosweep.example/checkout/success
PHOTOSWEEP_CHECKOUT_CANCEL_URL=https://photosweep.example/checkout/cancel
PHOTOSWEEP_RECOVERY_BASE_URL=https://photosweep-license-api-206538169327.us-west1.run.app
PHOTOSWEEP_RECOVERY_REDIRECT_URL=https://photosweep.example/license/recovered
# Valid email recovery requests always receive {"ok":true}; email delivery is
# attempted only for licenses with status=active. Missing, inactive, and
# refunded licenses are privacy-identical and do not send mail.
# Preferred sender: the Cloud Run Resend receiver. SMTP below is temporary
# fallback while the Resend domain and deployment are owner-approved.
PHOTOSWEEP_RECOVERY_EMAIL_WEBHOOK_URL=https://mail-automation.example/photosweep/recovery
PHOTOSWEEP_RECOVERY_EMAIL_WEBHOOK_SECRET=<RECOVERY_WEBHOOK_SECRET_VALUE>
PHOTOSWEEP_SMTP_HOST=<SMTP_HOST>
PHOTOSWEEP_SMTP_PORT=<SMTP_PORT>
PHOTOSWEEP_SMTP_USER=<SMTP_USERNAME>
PHOTOSWEEP_SMTP_PASS=<SMTP_PASSWORD>
PHOTOSWEEP_SMTP_FROM=<SMTP_FROM_ADDRESS>
PHOTOSWEEP_SMTP_SECURE=0
# Receiver-only configuration; map RESEND_API_KEY from Secret Manager.
RESEND_API_KEY=<RESEND_API_KEY_SECRET_VALUE>
RESEND_FROM=<RESEND_FROM_ADDRESS>
# Leave PHOTOSWEEP_UNSAFE_EMAIL_RECOVERY unset.
PHOTOSWEEP_COOKIE_SECURE=1
PHOTOSWEEP_LICENSE_STORE_PATH=.photosweep/license-store.json

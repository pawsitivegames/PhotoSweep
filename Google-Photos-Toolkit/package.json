{
  "name": "photosweep-google-photos-integration",
  "nameFull": "PhotoSweep Google Photos Integration",
  "version": "3.3.0",
  "description": "PhotoSweep's Google Photos content integration",
  "userScript": {
    "namespace": "PhotoSweep",
    "match": [
      "*://photos.google.com/*"
    ],
    "run-at": "body",
    "grant": [
      "GM_registerMenuCommand",
      "unsafeWindow"
    ],
    "noframes": ""
  },
  "main": "google_photos_toolkit.user.js",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "PhotoSweep contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pawsitivegames/PhotoSweep/issues"
  },
  "homepage": "https://github.com/pawsitivegames/PhotoSweep",
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@rollup/pluginutils": "^5.4.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.13.0",
    "rollup": "^4.62.4",
    "rollup-plugin-banner2": "^1.3.1",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "vite": "8.2.1",
    "vitest": "^5.0.5",
    "@eslint/js": "^10.0.1",
    "globals": "^17.13.0"
  }
}

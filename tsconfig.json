{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "Google-Photos-Toolkit",
    "build",
    "node_modules",
    "tmp",
    "workers",
    "vitest.config.mts"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "window.d.ts",
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "compilerOptions": {
    "moduleResolution": "bundler",
    "types": [
      "chrome",
      "node",
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom/vitest"
    ],
    "paths": {
      "~*": [
        "./*"
      ]
    }
  }
}

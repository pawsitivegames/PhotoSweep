{
  "schemaVersion": 1,
  "registryVersion": "2026-09-15",
  "project": "PhotoSweep",
  "sourceRoots": [
    "lib",
    "components",
    "tabs",
    "scripts",
    "workers",
    "background",
    "contents",
    "server",
    ".github",
    "Google-Photos-Toolkit",
    "tests",
    "verification",
    "tools",
    "package.json",
    "stryker.config.mjs",

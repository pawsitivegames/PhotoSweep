{
  "name": "photosweep",
  "displayName": "PhotoSweep for Google Photos™",
  "version": "2.3.6",
  "chromeVersion": "2.3.6.23",
  "description": "Find duplicates in Google Photos, iCloud Photos, and Amazon Photos where available. Review each Trash move. Matching stays local.",
  "author": "Mack Talcott",
  "scripts": {
    "preinstall": "node tools/check-node-version.js",
    "build:gptk": "(test -d Google-Photos-Toolkit/node_modules || npm --prefix Google-Photos-Toolkit ci --no-fund --no-audit) && npm --prefix Google-Photos-Toolkit run build && cp Google-Photos-Toolkit/google_photos_toolkit.user.js scripts/google-photos-toolkit.user.js",
    "copy:wasm": "cp node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_internal.js scripts/ && cp node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_internal.wasm scripts/",
    "build:worker": "node_modules/.bin/esbuild workers/embedder.worker.ts --bundle --platform=browser --format=iife --target=es2020 --outfile=scripts/embedder-worker.js",
    "pretypecheck": "node tools/write-build-flags.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit --project tsconfig.json",
    "pretest": "npm run build:gptk && PLASMO_PUBLIC_PHOTOSWEEP_ALLOW_DEV_ENTITLEMENT=test node tools/write-build-flags.mjs",
    "pretest:unit:fast": "npm run build:gptk && PLASMO_PUBLIC_PHOTOSWEEP_ALLOW_DEV_ENTITLEMENT=test node tools/write-build-flags.mjs",
    "test": "vitest run",
    "test:unit:fast": "PHOTOSWEEP_SKIP_DEEP_MODEL_REPLAY=1 vitest run",
    "test:fast": "vitest run tests/lib/duplicate-detector.test.ts tests/lib/duplicate-classifier.test.ts tests/lib/keeper-decisions.test.ts tests/lib/review-preflight.test.ts tests/components/keep-strategy-application.test.tsx tests/components/action-bar.test.tsx tests/lib/trash-dispatch-guard.test.ts tests/lib/trash-lifecycle.test.ts",
    "test:properties": "node verification/run-properties.mjs",
    "test:boundary": "vitest run tests/verification/fault-boundary.test.ts",
    "test:corpus": "vitest run tests/verification/corpus-quality.test.ts",
    "test:bench:verification": "node verification/run-performance.mjs",
    "test:evidence": "vitest run tests/verification/evidence-engine.test.ts",
    "test:mutation": "node verification/run-mutation.mjs",
    "verify:model": "node verification/run-tlc.mjs",
    "verify:model:outcomes": "node verification/run-mutation-outcomes-tlc.mjs",
    "test:model-replay": "node verification/trace-replay-runner.mjs",
    "verify:model:negative": "node verification/run-tlc-negative.mjs",
    "preverify:all": "PLASMO_PUBLIC_PHOTOSWEEP_ALLOW_DEV_ENTITLEMENT=0 node tools/write-build-flags.mjs",
    "verify:all": "node verification/verification-runner.mjs --scope fast",
    "preverify:nightly": "npm run preverify:all",
    "verify:nightly": "node verification/verification-runner.mjs --scope nightly",
    "preverify:release": "npm run preverify:all",
    "verify:release": "node verification/verification-runner.mjs --scope release",
    "test:bench": "vitest bench --run --dir tests/perf --reporter=json --outputFile=bench-output.json",
    "test:watch": "vitest",
    "test:integration": "node tools/run-integration-tests.mjs",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "license:serve": "node server/node-server.mjs",
    "analytics:export": "node tools/export-funnel-evidence.mjs",
    "stripe:setup-products": "node tools/setup-stripe-products.mjs",
    "stripe:reconcile": "node tools/export-stripe-ledger-evidence.mjs",
    "sync:scripts": "cp scripts/photo-provider-command-host.js scripts/google-photos-commands.js build/chrome-mv3-dev/scripts/ 2>/dev/null || true",
    "predev": "PLASMO_PUBLIC_PHOTOSWEEP_ALLOW_DEV_ENTITLEMENT=1 node tools/write-build-flags.mjs && npm run build:gptk && npm run copy:wasm && npm run build:worker && npm run sync:scripts",
    "dev": "node tools/run-secure-dev.mjs",
    "prebuild": "node tools/write-build-flags.mjs && npm run build:gptk && npm run copy:wasm && npm run build:worker",
    "build": "plasmo build && cp -r build/chrome-mv3-prod/. build/chrome-mv3-dev/",
    "package": "node tools/package-cws.mjs",
    "package:cws": "node tools/package-cws.mjs",
    "release": "bash tools/release.sh",
    "framer:probe": "node tools/framer-probe.mjs",
    "start": "node server/node-server.mjs",
    "audit:extension-package": "node tools/audit-extension-package.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/dm-sans": "^5.2.8",
    "@google-cloud/firestore": "^9.1.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-window": "^2.3.4"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^5.0.5",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "fast-glob": "file:tools/fast-glob-compat",
    "fflate": "0.8.3",
    "framer-api": "^5.1.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "plasmo": "^0.90.5",
    "prettier": "3.9.10",
    "svgo": "3.3.5",
    "typescript": "^7.0.2",
    "typescript-stryker-compat": "npm:typescript@5.8.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  },

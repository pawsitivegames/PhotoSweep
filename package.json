{
  "name": "photosweep",
  "displayName": "PhotoSweep for Google Photos™",
  "version": "2.3.0",
  "chromeVersion": "2.3.0.1",
  "description": "Find duplicate photos and videos in Google Photos. Matching stays in your browser. Review, then Trash only what you confirm.",
  "author": "Mack Talcott",
  "scripts": {
    "preinstall": "node tools/check-node-version.js",
    "build:gptk": "git submodule update --init && (test -d Google-Photos-Toolkit/node_modules || npm --prefix Google-Photos-Toolkit install --no-fund --no-audit) && cd Google-Photos-Toolkit && npm run build && cp google_photos_toolkit.user.js ../scripts/google-photos-toolkit.user.js",
    "copy:wasm": "cp node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_internal.js scripts/ && cp node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_internal.wasm scripts/",
    "build:worker": "node_modules/.bin/esbuild workers/embedder.worker.ts --bundle --platform=browser --format=iife --target=es2020 --outfile=scripts/embedder-worker.js",
    "pretypecheck": "node tools/write-build-flags.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "pretest": "PLASMO_PUBLIC_PHOTOSWEEP_ALLOW_DEV_ENTITLEMENT=test node tools/write-build-flags.mjs",
    "test": "vitest run",
    "test:properties": "node verification/run-properties.mjs",
    "test:boundary": "vitest run tests/verification/fault-boundary.test.ts",
    "test:corpus": "vitest run tests/verification/corpus-quality.test.ts",
    "test:bench:verification": "node verification/run-performance.mjs",
    "test:evidence": "vitest run tests/verification/evidence-engine.test.ts",
    "test:mutation": "node verification/run-mutation.mjs",
    "verify:model": "node verification/run-tlc.mjs",
    "test:model-replay": "node verification/trace-replay-runner.mjs",
    "verify:model:negative": "node verification/run-tlc-negative.mjs",
    "verify:all": "node verification/verification-runner.mjs --scope fast",
    "verify:nightly": "node verification/verification-runner.mjs --scope nightly",
    "verify:release": "node verification/verification-runner.mjs --scope release",
    "test:bench": "vitest bench --run",
    "test:watch": "vitest",
    "test:integration": "playwright test --config playwright.config.ts",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "license:serve": "node server/node-server.mjs",
    "analytics:export": "node tools/export-funnel-evidence.mjs",
    "stripe:setup-products": "node tools/setup-stripe-products.mjs",
    "stripe:reconcile": "node tools/export-stripe-ledger-evidence.mjs",
    "sync:scripts": "cp scripts/photo-provider-command-host.js scripts/google-photos-commands.js build/chrome-mv3-dev/scripts/ 2>/dev/null || true",
    "predev": "PLASMO_PUBLIC_PHOTOSWEEP_ALLOW_DEV_ENTITLEMENT=1 node tools/write-build-flags.mjs && npm run build:gptk && npm run copy:wasm && npm run build:worker && npm run sync:scripts",
    "dev": "plasmo dev",
    "prebuild": "node tools/write-build-flags.mjs && npm run build:gptk && npm run copy:wasm && npm run build:worker",
    "build": "plasmo build && cp -r build/chrome-mv3-prod/. build/chrome-mv3-dev/",
    "package": "npm run build && plasmo package",
    "package:cws": "node tools/package-cws.mjs",
    "release": "bash tools/release.sh",
    "framer:probe": "node tools/framer-probe.mjs",
    "start": "node server/node-server.mjs",
    "audit:extension-package": "node tools/audit-extension-package.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/dm-sans": "^5.2.8",
    "@google-cloud/firestore": "^9.1.0",
    "@mediapipe/tasks-vision": "^0.10.18",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-window": "^1.8.10"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@playwright/test": "^1.59.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "0.0.258",
    "@types/node": "^24",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.2",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "3.23.2",
    "framer-api": "^0.1.17",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.1",
    "plasmo": "^0.90.5",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vite": "^8.0.7",
    "vitest": "^4.1.2"
  },
